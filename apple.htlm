<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Ruby Apple Room</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    html, body {
      margin: 0;
      padding: 0;
      height: 100vh;
      background: black;
      overflow: hidden;
      background-image: url('background.jpg');
      background-size: cover;
      background-position: center;
    }

    .apple {
      position: absolute;
      width: 70px;
      transition: transform 0.4s ease, filter 0.4s ease;
    }

    .apple:hover {
      transform: scale(1.1);
      filter: drop-shadow(0 0 12px red) brightness(1.5);
    }

    /* Apple placement - floating, magical layout */
    #a1 { top: 30%; left: 20%; }
    #a2 { top: 50%; left: 40%; }
    #a3 { top: 60%; left: 65%; }
    #a4 { top: 35%; left: 75%; }

    /* Back Button */
    #back-btn {
      position: absolute;
      bottom: 20px;
      left: 20px;
      width: 50px;
      cursor: pointer;
      filter: drop-shadow(0 0 10px crimson);
      transition: transform 0.3s ease;
    }

    #back-btn:hover {
      transform: scale(1.1);
    }
  </style>
</head>
<body>

  <img id="a1" class="apple" src="spiral.png" alt="ruby apple">
  <img id="a2" class="apple" src="spiral.png" alt="ruby apple">
  <img id="a3" class="apple" src="spiral.png" alt="ruby apple">
  <img id="a4" class="apple" src="spiral.png" alt="ruby apple">

  <!-- Back to home -->
  <a href="index.html">
    <img id="back-btn" src="leaf.png" alt="Back">
  </a>

</body>
</html>